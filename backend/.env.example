# Copy to .env for local runs. Never commit a real .env.
PORT=10000
DATABASE_URL=postgresql://user:password@host:5432/travelfix_db
FRONTEND_URL=https://travelfix.vercel.app
JWT_SECRET=change-me-to-a-long-random-string
# Gemini (Google AI Studio, free tier) — powers grounded AI plans and
# follow-up replies. If unset, the backend falls back to template plans.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
